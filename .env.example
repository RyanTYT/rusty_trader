ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

GRAFANA_ADMIN_PASSWORD=change-me

# Paths are resolved relative to compose/, not the repo root.
IBC_CONFIG_PATH=../infra/ib-gateway/IBCMacos-3.20.0/config.ini

