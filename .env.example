# Autotrader environment reference.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#   chmod 600 .env
#
# .env is gitignored. Never commit it or bake it into an image. Release bundles
# never contain it; scripts/deploy.sh copies it to prod's shared/.env.

# ── Image selection ────────────────────────────────────────────────────────
# Release tags are generated by scripts/release.sh from the HEAD commit
# timestamp and short hash, then written to prod's shared/.env by deploy.sh.
# Do not set IMAGE_TAG in this file.

# ── Database ───────────────────────────────────────────────────────────────
DB_USER=trading
DB_PW=change-me
# The trading migrations ALTER DATABASE trading_system, so this must match.
DB_DB=trading_system
# small / medium / large - 4GB RAM / 8GB RAM / 16GB RAM
MEMORY_LIMIT=small

# ── Trading bot / IB Gateway ───────────────────────────────────────────────
# Dev: relative to the compose/ directory.
# Prod: use an absolute path, e.g.
#   IBC_CONFIG_PATH=/opt/autotrader/shared/ib-gateway/config.ini
IBC_CONFIG_PATH=../infra/ib-gateway/IBCMacos-3.20.0/config.ini

# ── External APIs ──────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Shared secret used by backend, llm_service, and scraper.
BACKEND_BEARER_TOKEN=change-me

# Internal address used by the backend to reach the trading bot.
TRADING_BOT_URL=http://trading-bot:8000

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Monitoring ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-me

# Defaults to the example config. For production, point at the real
# gitignored config, e.g.
#   ALERTMANAGER_CONFIG=/opt/autotrader/shared/alertmanager.yml
# ALERTMANAGER_CONFIG=../infra/alertmanager/alertmanager.yml

# ── Data puller (dev-only stack) ───────────────────────────────────────────
# The data-puller stack reads these from the same .env. It is not deployed to
# production.
# TF=5 mins
# MODE=extend
# PULL_START=2024-01-01
# PULL_END=2026-06-30
