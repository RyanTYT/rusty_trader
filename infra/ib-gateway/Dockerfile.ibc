# Self-contained IB Gateway + IBC (IB Controller) image with headless auto-login.
#
# Uses the LOCAL IBCLinux-3.21.2.zip (at trading/trading-app/) — provided by the
# user, gitignored. The IB Gateway installer is downloaded at build time (it's
# not in the repo). The only other local file needed is the IBC config.ini
# (with your IBKR paper credentials) at trading/trading-app/IBCMacos-3.20.0/config.ini.
#
# Paper account → no 2FA (IBKR paper accounts don't trigger the second factor).
#
# Build context MUST be the repo root (.) so this Dockerfile can COPY the local
# IBC zip + config.ini + the entrypoint. Build:
#   docker compose build tws
# Run (auto-starts Xvfb + IBC + the IB Gateway, auto-logins via config.ini):
#   docker compose up -d tws

FROM debian:bookworm-slim

# bookworm = Debian 12 (current stable, NOT EOL — apt repos work natively).
# create the tws user (matches the original infra/ib-gateway image)
ENV HOME=/home/tws
RUN groupadd --gid 501 tws && \
    useradd -ms /bin/bash --uid 501 --gid 501 tws && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl unzip xvfb \
      openjdk-17-jre openjfx \
      libxtst6 libxi6 libxrender1 libxrandr2 libfreetype6 \
      libxext6 libx11-6 libxfixes3 libxinerama1 libxcursor1 libgl1-mesa-glx \
      libgtk-3-0 libgdk-pixbuf-2.0-0 libglib2.0-0 libpango-1.0-0 \
      libcairo2 libpangocairo-1.0-0 \
      libgl1-mesa-dri libegl1 libglx-mesa0 \
      xfonts-base xfonts-encodings xfonts-utils \
      libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 \
      libxkbcommon0 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

USER tws
WORKDIR /home/tws
RUN mkdir -p /home/tws/ibgateway/1030 /home/tws/ibc/logs

# ── IB Gateway (local installer — provided by the user) ────────────────────
COPY --chown=tws:tws infra/ib-gateway/ibgateway-stable-standalone-linux-x64.sh /tmp/ibgateway.sh
RUN sh /tmp/ibgateway.sh -q -dir /home/tws/ibgateway/1030/ > /home/tws/ib-install.log 2>&1 && \
    rm /tmp/ibgateway.sh

# ── IBC (IB Controller) 3.21.2 — LOCAL zip (provided by the user) ──────────
COPY --chown=tws:tws trading/trading-app/IBCLinux-3.21.2.zip /tmp/ibc.zip
RUN unzip -q /tmp/ibc.zip -d /home/tws/ibc/ && \
    chmod -R u+x /home/tws/ibc/ && \
    rm /tmp/ibc.zip

# ── IBC config (credentials — gitignored, must exist locally) ─────────────
COPY --chown=tws:tws trading/trading-app/IBCMacos-3.20.0/config.ini /home/tws/ibc/config.ini

# ── entrypoint (Xvfb + IBC auto-start) ─────────────────────────────────────
COPY --chown=tws:tws infra/ib-gateway/entrypoint-ibc.sh /home/tws/entrypoint-ibc.sh
RUN chmod +x /home/tws/entrypoint-ibc.sh

ENTRYPOINT ["/home/tws/entrypoint-ibc.sh"]
