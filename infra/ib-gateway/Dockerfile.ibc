# IB Gateway + IBC, for headless (Xvfb) use.
#
# The data-puller image includes IB Gateway, IBC, and the Python puller, so
# `ibcstart.sh` finds `${tws_path}/ibgateway/${tws_version}/jars`. The Gateway
# installer is the same one used by the trading-app images.
#
# Build context MUST be the repository root (it also copies scripts/ and
# trading source); the IBC assets themselves live here under infra/ib-gateway/:
#
#   docker build --platform linux/amd64 \
#     -f infra/ib-gateway/Dockerfile.ibc -t ib-gateway-ibc .
#
# --platform linux/amd64 is MANDATORY: the Gateway installer is a linux-x64
# install4j binary, so an arm64 image (the default on Apple Silicon) cannot
# install it. The data-puller compose pins linux/amd64 for its `tws` service
# for the same reason.
#
# Runtime: entrypoint-ibc.sh boots Xvfb + IBC and waits for a real login
# before handing off. Intended to be combined with a puller in ONE container so
# the client can reach the gateway on 127.0.0.1:4002 -- `network_mode: host`
# is a no-op on Docker Desktop for macOS.
FROM --platform=linux/amd64 python:3.12-slim-trixie

# X libs for the Gateway's bundled JRE + IBC's Swing UI, plus Xvfb for a
# display. Same set as Dockerfile.backtest on Debian trixie (`libgl1` replaced
# `libgl1-mesa-glx`).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libxtst6 libxi6 libxrender1 libxrandr2 libfreetype6 libxext6 \
      libx11-6 libxfixes3 libxinerama1 libxcursor1 libgl1 \
      unzip xvfb curl procps ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*

# ── IB Gateway (offline install; IBC requires a non-auto-updating install) ──
# `-dir` is resolved by the install4j installer relative to the SCRIPT'S own
# location, not the working directory, so it must be absolute -- otherwise a
# copy in /tmp silently installs to /tmp/ibgateway/1030.
COPY infra/ib-gateway/ibgateway-stable-standalone-linux-x64.sh /home/tws/ibgw.sh
RUN chmod +x /home/tws/ibgw.sh \
 && /home/tws/ibgw.sh -q -dir /home/tws/ibgateway/1030/ \
 && rm -f /home/tws/ibgw.sh \
 && test -d /home/tws/ibgateway/1030/jars \
 && ls /home/tws/ibgateway/1030 | head \
 && echo "IB Gateway installed to /home/tws/ibgateway/1030"

# ── IBC ──────────────────────────────────────────────────────────────────────
# Same IBC build + config the trading-app images use, so credentials and IBC
# settings stay in one place.
COPY infra/ib-gateway/IBCLinux-3.21.2.zip /IBCLinux-3.21.2.zip
RUN unzip /IBCLinux-3.21.2.zip -d /IBCLinux-3.21.2/ \
 && rm -f /IBCLinux-3.21.2.zip \
 && chmod -u+x -R /IBCLinux-3.21.2/

COPY infra/ib-gateway/IBCMacos-3.20.0/config.ini /IBCLinux-3.21.2/config.ini
COPY infra/ib-gateway/IBCMacos-3.20.0/scripts/ibcstart.sh \
     /IBCLinux-3.21.2/scripts/ibcstart.sh
RUN chmod -u+x -R /IBCLinux-3.21.2/

# ── puller ───────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir ib_async pandas pyarrow duckdb
COPY scripts/data_puller/experiments/pull_1min_bars.py /app/pull_1min_bars.py
COPY scripts/data_puller/experiments/pull_5min_bars.py /app/pull_5min_bars.py
COPY scripts/data_puller/ib_throttle.py /app/ib_throttle.py
# build_universes.py (in universes/) produces the research-universe JSONs the
# retired puller imported; they must be in the image or the archaeology puller
# dies at startup -- which is exactly what happened on the first benchmark run.
COPY scripts/data_puller/universes/build_universes.py /app/build_universes.py
COPY scripts/data_puller/universes/existing_41.json /app/universes/existing_41.json
COPY scripts/data_puller/universes/benchmarks.json /app/universes/benchmarks.json
COPY scripts/data_puller/universes/all_new.json /app/universes/all_new.json
COPY scripts/data_puller/universes/full_universe.json /app/universes/full_universe.json
COPY scripts/data_puller/universes/excluded_no_contract.json /app/universes/excluded_no_contract.json
COPY scripts/data_puller/experiments/screen_universe.py /app/screen_universe.py
# (filter_universe.py retired/removed; the old 3-file chain
#  select_universe/universe_candidates/universe_design merged into
#  universes/build_universes.py)
COPY scripts/data_puller/experiments/diag_ib_1min.py /app/diag_ib_1min.py
COPY scripts/data_puller/Dockerfile.pull_1min /app/Dockerfile.pull_1min
WORKDIR /app

COPY infra/ib-gateway/entrypoint-ibc.sh /entrypoint-ibc.sh
RUN chmod +x /entrypoint-ibc.sh

ENV TZ=US/Eastern \
    PYTHONUNBUFFERED=1 \
    IB_HOST=127.0.0.1 \
    IB_PORT=4002 \
    IB_CLIENT_ID=15 \
    GATEWAY_PORT=4002 \
    IBC_COMMAND_PORT=7462 \
    GATEWAY_STARTUP_TIMEOUT=300 \
    GATEWAY_VERSION=1030

# NOTE: config.ini ships with TradingMode=live and live credentials. The
# entrypoint forces `--mode=paper`, and RUN_COMMAND defaults to a --dry-run so
# a bare `docker run` can never mutate data or touch a live account. Override
# RUN_COMMAND explicitly to do real work, e.g.
#   -e RUN_COMMAND="python -u /app/pull_1min_bars.py --mode repair"
ENV RUN_COMMAND="python -u /app/pull_1min_bars.py --dry-run --mode repair"

CMD ["/entrypoint-ibc.sh"]
