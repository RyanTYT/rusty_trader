  "query": "\n                SELECT\n                    execution_id as \"execution_id!\",\n                    strategy as \"strategy!\",\n                    stock as \"stock!\",\n                    primary_exchange as \"primary_exchange!\",\n                    currency as \"currency!\",\n                    order_perm_id as \"order_perm_id!\",\n                    time as \"time!\",\n                    price as \"price!\",\n                    quantity as \"quantity!\",\n                    fees as \"fees!\"\n                FROM trading.stock_transactions\n                WHERE strategy = $1\n                ORDER BY time ASC;\n                ",
