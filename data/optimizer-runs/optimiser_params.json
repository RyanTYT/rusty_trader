      {
        "stock": "QQQ",
        "primary_exchange": "NASDAQ",
        "currency": "USD",
        "asset_type": "stock"
      }
    ],
    "params": [
      {
        "name": "daily_vol_threshold",
        "value_type": "F64",
        "comment": "Threshold separating high-vol vs low-vol regimes (if daily_vol >= threshold → high_vol qty). Continuous around the default 0.04.",
        "distribution": {
          "Continuous": {
            "min": 0.02,
            "max": 0.08,
            "modes": [{ "mean": 0.04, "std": 0.015, "weight": 1.0 }]
          }
        }
      },
      {
        "name": "ideal_qty_high_vol",
        "value_type": "I32",
        "comment": "Ideal position size (shares) when daily vol is HIGH — smaller position. Continuous around the default 70.",
        "distribution": {
          "Continuous": {
            "min": 40.0,
            "max": 100.0,
            "modes": [{ "mean": 70.0, "std": 15.0, "weight": 1.0 }]
          }
        }
      },
      {
        "name": "ideal_qty_low_vol",
        "value_type": "I32",
        "comment": "Ideal position size (shares) when daily vol is LOW — must be > high_vol. build_upon on ideal_qty_high_vol: final = sampled_extra + high_vol. Sampled extra [20,40] (mean 30) → low_vol = high_vol + 30 = 70+30 = 100 (default). Ensures low_vol > high_vol always.",
        "distribution": {
          "Continuous": {
            "min": 20.0,
            "max": 40.0,
            "modes": [{ "mean": 30.0, "std": 5.0, "weight": 1.0 }]
          }
        },
        "build_upon": "ideal_qty_high_vol"
      },
      {
        "name": "act_interval_minutes",
        "value_type": "U32",
        "comment": "Act-on-bar interval (minutes). Must divide 60 (bar.minute is 0..59). Discrete divisors of 60 — the natural intraday act intervals. Default 30.",
        "distribution": { "Discrete": [5.0, 10.0, 15.0, 20.0, 30.0, 60.0] }
      },
      {
        "name": "noise_multiplier",
        "value_type": "F64",
        "comment": "Noise-band sensitivity: upper_noise = (1 + multiplier * avg_move) * open. Higher → wider band → less sensitive (fewer trades). Continuous around the default 1.0.",
        "distribution": {
          "Continuous": {
            "min": 0.5,
            "max": 2.0,
            "modes": [{ "mean": 1.0, "std": 0.375, "weight": 1.0 }]
          }
        }
      },
      {
        "name": "avg_move_lookback",
        "value_type": "U32",
        "comment": "Lookback (day count) for the avg-move-since-open RollingMean window. Discrete round day counts. Default 15.",
        "distribution": {
          "Discrete": [5.0, 10.0, 15.0, 20.0, 30.0, 45.0, 60.0]
        }
      },
      {
        "name": "vol_lookback",
        "value_type": "U32",
        "comment": "Lookback (day count) for the daily-volatility RollingStd window. Discrete weekly multiples. Default 14.",
        "distribution": { "Discrete": [7.0, 14.0, 21.0, 28.0, 42.0, 63.0] }
      }
    ]
