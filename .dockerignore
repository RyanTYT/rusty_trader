# — none of which are in the dirs below.

# 43GB — GDELT raw data + research outputs
research/
# 20GB — Rust build artifacts
trading/trading-app/target/
**/target/
# 1.4GB — backtest results, postgres data
data/
# 1.5GB — Python venv
.venv/
# git
.git/
# IBC logs (regenerated at runtime)
trading/trading-app/IBCMacos-3.20.0/logs/

# misc large / junk
