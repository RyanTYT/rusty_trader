ARG RUST_VERSION=1.85.1

# =============================================================================
# Stage 1: Build the test binaries (unit_tests, integration_tests, smoke_tests)
# =============================================================================
FROM --platform=linux/amd64 rust:${RUST_VERSION}-slim AS build
WORKDIR /app

# Install build dependencies (clang/lld for ibapi, pkg-config for openssl,
# postgresql-client for pg_isready + sqlx-cli for migrations, protobuf-compiler)
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    clang \
    lld \
    musl-dev \
    git \
    bash \
    ca-certificates \
    curl \
    unzip \
    postgresql-client \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Install sqlx-cli for running migrations (version pinned to match Cargo)
RUN cargo install sqlx-cli --no-default-features --features postgres

# Copy manifests first (for better caching of dependencies)
COPY Cargo.toml Cargo.lock ./

# Copy local dependencies and migrations + sqlx offline cache (needed at compile time)
COPY crud_insertable ./crud_insertable
COPY crud_insertable_macro ./crud_insertable_macro
COPY crud_models ./crud_models
COPY spmc-ring ./spmc-ring
COPY .sqlx ./.sqlx
COPY migrations ./migrations

# Create a dummy main.rs + dummy tests dir to build dependencies only
RUN mkdir -p src tests/unit_tests tests/integration_tests tests/smoke_tests/live && \
    echo "fn main() {println!(\"if you see this, the build broke\")}" > src/main.rs && \
    echo "#[test] fn dummy() { assert!(true); }" > tests/unit_tests.rs && \
    echo "#[test] fn dummy() { assert!(true); }" > tests/integration_tests.rs && \
    echo "#[test] fn dummy() { assert!(true); }" > tests/smoke_tests.rs

# Build dependencies only (cache layer) — no test binaries yet
ENV SQLX_OFFLINE=true
RUN cargo build --tests 2>&1 || true

# Now copy the actual source + tests
COPY src ./src
COPY tests ./tests

# Build the test binaries (no-run — we'll run them in the final stage)
# Touch test files to force rebuild of the test code
RUN touch tests/unit_tests.rs tests/integration_tests.rs tests/smoke_tests.rs && \
    cargo build --tests 2>&1

# =============================================================================
# Stage 2: Final image with IBC + Xvfb + test binaries
# =============================================================================
FROM --platform=linux/amd64 debian:bullseye-slim AS final
WORKDIR /app

# Install runtime deps for TWS/IB Gateway + Xvfb + postgresql-client + curl
RUN apt-get update && apt-get install -y \
    libxtst6 libxi6 libxrender1 libxrandr2 libfreetype6 libxext6 \
    libx11-6 libxfixes3 libxinerama1 libxcursor1 libgl1-mesa-glx \
    libasound2 libasound2-plugins libgbm1 libnss3 libxss1 \
    xdotool openbox \
    unzip xvfb \
    curl bash ca-certificates \
    postgresql-client \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install IBC (IB Gateway controller) — conditional: only if the zip is present
# at build time. If absent, smoke tests are skipped by the entrypoint.
COPY IBCLinux-3.21.2.zip* /tmp/IBCLinux-3.21.2.zip
RUN if [ -s /tmp/IBCLinux-3.21.2.zip ]; then \
        unzip /tmp/IBCLinux-3.21.2.zip -d /IBCLinux-3.21.2/; \
        chown -R root /IBCLinux-3.21.2/; \
        chmod -R u+x /IBCLinux-3.21.2/; \
        echo "IBC installed"; \
    else \
        echo "IBCLinux-3.21.2.zip not provided — smoke tests will be skipped"; \
        mkdir -p /IBCLinux-3.21.2/scripts; \
    fi
# Copy config.ini + ibcstart.sh (from the IBCMacos dir) — conditional
COPY IBCMacos-3.20.0/config.ini* /IBCLinux-3.21.2/config.ini
COPY IBCMacos-3.20.0/scripts/ibcstart.sh /IBCLinux-3.21.2/scripts/ibcstart.sh
RUN chmod -R u+x /IBCLinux-3.21.2/ 2>/dev/null || true

# Copy the compiled test binaries + source (cargo test needs the source + cargo to run)
COPY --from=build /app /app

# Copy the Rust toolchain (cargo + rustc) from the build stage so we can run
# `cargo test` without reinstalling rust (which would download ~1GB).
# rust:slim installs to /usr/local/cargo + /usr/local/rustup
COPY --from=build /usr/local/cargo /usr/local/cargo
COPY --from=build /usr/local/rustup /usr/local/rustup
ENV PATH="/usr/local/cargo/bin:${PATH}"

# Copy sqlx-cli binary from the build stage (for migrations)
COPY --from=build /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx

# Copy the test entrypoint script
COPY test-entrypoint.sh /test-entrypoint.sh
RUN chmod +x /test-entrypoint.sh

ENV SQLX_OFFLINE=true
ENV RUST_BACKTRACE=1

ENTRYPOINT ["sh", "/test-entrypoint.sh"]
